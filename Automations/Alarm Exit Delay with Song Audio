alias: Alarm Exit Delay with Song Audio
description: Starts exit delay timer only when all alarm sensors are closed
triggers:
  - entity_id:
      - alarm_control_panel.alarm_panel_pro_house_alarm
    to:
      - arming
    trigger: state
conditions: []
actions:
  - choose:
      - conditions:
          - condition: template
            value_template: "{{ states('input_text.alarm_open_sensors') | trim != '' }}"
        sequence:
          - action: alarm_control_panel.alarm_disarm
            target:
              entity_id: alarm_control_panel.alarm_panel_pro_house_alarm
          - action: input_boolean.turn_on
            target:
              entity_id: input_boolean.alarm_arm_failed
          - action: media_player.turn_on
            target:
              entity_id: group.kiosks
          - action: media_player.turn_on
            target:
              entity_id: media_player.a12_kiosk
          - delay:
              seconds: 1
          - action: androidtv.adb_command
            target:
              entity_id: media_player.a12_kiosk
            data:
              command: wm dismiss-keyguard
          - delay:
              seconds: 1
          - action: androidtv.adb_command
            target:
              entity_id: media_player.a12_kiosk
            data:
              command: monkey -p io.homeassistant.companion.android 1
          - stop: Alarm not armed - open sensors detected
    default:
      - action: input_boolean.turn_off
        target:
          entity_id: input_boolean.alarm_arm_failed
      - action: timer.start
        target:
          entity_id: timer.alarm_entry_delay
      - action: media_player.turn_on
        target:
          entity_id: group.kiosks
      - action: media_player.play_media
        target:
          device_id: 2c7b284941901c29c784db2bdd65146c
        data:
          media:
            media_content_id: media-source://media_source/local/timer.mp3
            media_content_type: audio/mpeg
      - wait_for_trigger:
          - entity_id: timer.alarm_entry_delay
            to: idle
            trigger: state
          - entity_id: alarm_control_panel.alarm_panel_pro_house_alarm
            to: disarmed
            trigger: state
          - entity_id: alarm_control_panel.alarm_panel_pro_house_alarm
            to: armed_away
            trigger: state
          - entity_id: alarm_control_panel.alarm_panel_pro_house_alarm
            to: armed_home
            trigger: state
      - action: media_player.media_stop
        target:
          device_id: 2c7b284941901c29c784db2bdd65146c
      - action: timer.cancel
        target:
          entity_id: timer.alarm_entry_delay
mode: restart
