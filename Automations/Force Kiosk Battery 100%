alias: Force Kiosk Battery 100%
description: Spoof Kiosks battery to 100%
triggers:
  - minutes: /10
    trigger: time_pattern
  - event: start
    trigger: homeassistant
actions:
  - data:
      command: dumpsys battery set level 100
    action: androidtv.adb_command
    target:
      entity_id: group.kiosks
  - delay: "00:00:02"
  - data:
      command: dumpsys battery set status 1
    action: androidtv.adb_command
    target:
      entity_id: group.kiosks
mode: single
