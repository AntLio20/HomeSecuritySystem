alias: Alarm Open Sensor Tracker
description: Maintains a list of all currently open alarm sensors
triggers:
  - entity_id:
      - group.window_sensors
      - group.door_sensors
    trigger: state
  - trigger: homeassistant
    event: start
actions:
  - action: input_text.set_value
    target:
      entity_id: input_text.alarm_open_sensors
    data:
      value: >-
        {% set open_sensors = [] %}

        {% if is_state('binary_sensor.konnected_front_door', 'on')
        %}
          {% set open_sensors = open_sensors + ['Front Door'] %}
        {% endif %}

        {% if is_state('binary_sensor.konnected_side_door', 'on')
        %}
          {% set open_sensors = open_sensors + ['Side Door'] %}
        {% endif %}

        {% if is_state('binary_sensor.konnected_rear_door', 'on')
        %}
          {% set open_sensors = open_sensors + ['Rear Door'] %}
        {% endif %}

        {% if is_state('binary_sensor.konnected_garage_door', 'on')
        %}
          {% set open_sensors = open_sensors + ['Garage Door'] %}
        {% endif %}

        {% if
        is_state('binary_sensor.konnected_upstairs_east_windows',
        'on') %}
          {% set open_sensors = open_sensors + ['Upstairs East Windows'] %}
        {% endif %}

        {% if
        is_state('binary_sensor.konnected_upstairs_west_windows',
        'on') %}
          {% set open_sensors = open_sensors + ['Upstairs West Windows'] %}
        {% endif %}

        {% if
        is_state('binary_sensor.konnected_downstairs_windows',
        'on') %}
          {% set open_sensors = open_sensors + ['Downstairs Windows'] %}
        {% endif %}

        {{ open_sensors | join(', ') }}
mode: restart
