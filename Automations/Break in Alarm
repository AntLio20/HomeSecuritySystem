alias: Break in Alarm
triggers:
  - trigger: state
    entity_id:
      - binary_sensor.konnected_rear_door
      - binary_sensor.konnected_garage_door
      - binary_sensor.window_sensors
    to: "on"
conditions:
  - condition: state
    entity_id: alarm_control_panel.alarm_panel_pro_house_alarm
    state: armed_away
actions:
  - action: alarm_control_panel.alarm_trigger
    target:
      entity_id: alarm_control_panel.alarm_panel_pro_house_alar
